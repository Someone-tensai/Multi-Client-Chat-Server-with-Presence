FROM ubuntu:22.04 AS builder

RUN apt-get update && apt-get install -y \
    build-essential \
    libsqlite3-dev \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY include/ include/
COPY src/ src/
COPY Makefile .

RUN make SERVER_SRCS="src/server.c src/client_handler.c src/registry.c src/protocol.c src/display.c src/threadpool.c src/db.c src/config.c src/log.c src/session.c src/receipt.c src/presence.c src/block.c src/permission.c src/invite.c src/redis.c src/pg.c src/metrics.c"

FROM ubuntu:22.04

RUN apt-get update && apt-get install -y \
    libsqlite3-0 \
    libssl3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /app/server .
COPY server.conf .

EXPOSE 8888

CMD ["./server"]
